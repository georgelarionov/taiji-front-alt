# Боевая конфигурация: сайт и админка на постоянных доменах.
# Сертификаты Caddy получает сам (Let's Encrypt) — для этого A-записи доменов
# должны уже указывать на этот сервер, иначе ACME не пройдёт проверку.
#
# Ставится как /etc/caddy/Caddyfile. Пока DNS не переключён, вместо этого файла
# используется Caddyfile.staging (доступ по IP, без TLS); переключает golive.sh.

taiji-society.ru {
	encode zstd gzip

	handle {
		root * /var/www/taiji
		file_server
	}

	# Astro кладёт хешированные ассеты в /_astro — их можно кешировать вечно.
	header /_astro/* Cache-Control "public, max-age=31536000, immutable"

	# HSTS. Если понадобится откатиться на http — убрать эту строку И дождаться
	# истечения max-age у уже побывавших на сайте браузеров.
	header Strict-Transport-Security "max-age=31536000"

	# Своя 404 вместо каддиевской заглушки. Именно 404, а не отдача главной:
	# SPA-фолбэк (как было на Railway) прячет битые ссылки за кодом 200.
	handle_errors {
		root * /var/www/taiji
		rewrite * /404.html
		file_server
	}
}

www.taiji-society.ru {
	redir https://taiji-society.ru{uri} permanent
}

cms.taiji-society.ru {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000

	# Админку в поиске видеть незачем.
	header X-Robots-Tag "noindex, nofollow"
}
