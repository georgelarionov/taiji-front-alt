# Временная конфигурация на период, пока DNS ещё смотрит на старый хостинг.
# Всё отдаётся по IP и по чистому HTTP: сертификат на голый IP не выпустить.
#
# Сайт — в корне, админка и API проксируются на CMS по тем же путям, что и на
# боевом поддомене, чтобы проверить связку целиком до переключения доменов.
# После go-live этот файл не используется (golive.sh ставит обычный Caddyfile) —
# держать админку на HTTP нельзя, пароль уедет открытым текстом.

http://5.129.221.211 {
	encode zstd gzip

	@cms path /admin /admin/* /api/* /_next/*
	handle @cms {
		reverse_proxy 127.0.0.1:3000
	}

	handle {
		root * /var/www/taiji
		file_server
	}

	handle_errors {
		root * /var/www/taiji
		rewrite * /404.html
		file_server
	}
}
