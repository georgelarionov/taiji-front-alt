---
// Страница «Анонсы» (/events). Пока заглушка: списков мероприятий ещё нет —
// показываем простое пустое состояние (табы «Предстоящие/Прошедшие» и подпись
// «События Общества» убраны до появления данных из CMS; остров EventsTabs больше
// не используется). Шелл как у /taijiquan: solid-шапка (активный пункт «Анонсы»),
// крошки отдельным блоком, сквозной глобальный футер.
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Footer from "../components/Footer.astro";
import PageTitleBand from "../components/PageTitleBand.astro";
import { webPageSchema } from "../lib/seo";

// Пока страница — заглушка (списков мероприятий ещё нет) → честный тип WebPage,
// не CollectionPage (коллекция пустая). Сменить на CollectionPage, когда из CMS
// появятся реальные мероприятия для ItemList.
const description =
  "Анонсы Общества изучения традиционного тайцзицюань: предстоящие и прошедшие события, семинары и открытые тренировки.";
const schema = webPageSchema({
  site: Astro.site,
  path: Astro.url.pathname,
  name: "Анонсы",
  description,
});
---

<BaseLayout
  title="Анонсы — Общество изучения традиционного тайцзицюань"
  description={description}
  schema={schema}
>
  <Header variant="solid" activeNav="Анонсы" />
  <Breadcrumbs
    items={[{ label: "Главная", href: "/" }, { label: "Анонсы" }]}
  />
  <PageTitleBand title="Анонсы" />

  <section class="bg-white pt-16 pb-48 max-lg:pt-12 max-lg:pb-28">
    <div class="container-block">
      <div
        data-reveal
        class="grid min-h-[520px] place-items-center rounded-[2px] border border-dashed border-border px-6 text-center max-lg:min-h-[420px]"
      >
        <p class="font-display text-lg font-semibold text-ink/50 max-lg:text-base">
          Скоро здесь будет информация
        </p>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
