---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeIntro from "../components/HomeIntro.astro";
// import Hero from "../components/Hero.astro"; // старый 1-block (hero-слайдер) — заменён на HomeIntro
import About from "../components/About.astro";
// import Research from "../components/Research.astro"; // блок «Исследования» скрыт на главной
import News from "../components/News.astro";
import Society from "../components/Society.astro";
import Contacts from "../components/Contacts.astro";
import Footer from "../components/Footer.astro";
import {
  webPageSchema,
  SITE_NAME,
  SITE_DESCRIPTION,
  SITE_OG_DESCRIPTION,
} from "../lib/seo";

const schema = webPageSchema({
  site: Astro.site,
  path: Astro.url.pathname,
  name: SITE_NAME,
  description: SITE_DESCRIPTION,
  image: "/og-main.png",
});
---

{/* description — длинное, для поиска; ogDescription — короткое, для карточки
    при шеринге (в превью мессенджеров длинное обрезается на полуслове). */}
<BaseLayout
  title="Общество изучения традиционного тайцзицюань"
  description={SITE_DESCRIPTION}
  ogDescription={SITE_OG_DESCRIPTION}
  schema={schema}
>
  {/* Главная — собирается поблочно. 1-block — новый вводный экран HomeIntro
      (design/new-1-block): статичный, шапка внутри блока. Sticky-параллакс
      старого hero больше не действует, поэтому обёртки z-10 нет — блоки идут
      обычным потоком (у каждого свой bg-white). */}
  <HomeIntro />
  {/* Порядок блоков; «Исследования» (<Research />) скрыт по запросу */}
  <News />
  <Society />
  <About />
  <Contacts />
  <Footer />
</BaseLayout>
