---
// Страница «Исследования» (/research). Шелл как у /taijiquan (solid-шапка с активным
// пунктом «Исследования», крошки отдельным блоком, сквозной футер) + тайтл-баннер.
// Контент — якорные блоки друг за другом: «Источники» (#sources), «Публикации»
// (#publications), «Конференции» (#conferences) и «Фестивали» (#festivals); последние
// два пока заглушки «Скоро здесь будет информация». Якоря продублированы в бургер-меню
// и футере (config/nav.ts).
// Карточки — внешние ссылки (открываются в новом окне). Материалы отобраны из
// списков «Источники» лонгридов /taijiquan/{history,theory,practice} — самые значимые
// первоисточники (переводы классических трактатов, запись ЮНЕСКО) и научные публикации.
// Тайтлы карточек переведены на русский; ссылка ведёт на оригинал.
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ContactBar from "../components/ContactBar.astro";
import Footer from "../components/Footer.astro";
import PageTitleBand from "../components/PageTitleBand.astro";
import ResearchLinkCard from "../components/research/ResearchLinkCard.astro";
import ConferenceDrawer from "../components/research/ConferenceDrawer";
import { getSources, getPublications } from "../lib/cms/research";
import { getConferenceArticles } from "../lib/cms/news";
import { collectionPageSchema } from "../lib/seo";

// Первая конференция (Москва, декабрь 2025). Карточка в секции «Конференции» открывает
// дровер-хаб (ConferenceDrawer): новости — ссылки на существующие статьи, трансляция —
// диплинк в видеоархив (#video-<id>), документы/публикации — заглушки.
const sources = await getSources();
const publications = await getPublications();
const conferenceArticles = await getConferenceArticles();

const CONFERENCE_TITLE =
  "Первая научно-практическая конференция «Тайцзицюань — нематериальное культурное наследие человечества, феномен китайской цивилизации»";
const CONFERENCE_PLACE = "Москва · декабрь 2025 г.";
const conferenceNews = conferenceArticles.map((a) => ({
  date: a.date,
  title: a.title,
  href: `/news/${a.slug}`,
}));
const conferenceBroadcastHref = "/media-archive#video-conference-2025";

// CollectionPage + ItemList материалов: внешние ресурсы как item:{@type} (классические
// трактаты — CreativeWork, статьи исследователей — ScholarlyArticle), а не «голый» url.
const description =
  "Исследования Общества изучения традиционного тайцзицюань: первоисточники (классические трактаты, запись ЮНЕСКО) и научные публикации о тайцзицюань.";
const schema = collectionPageSchema(
  {
    site: Astro.site,
    path: Astro.url.pathname,
    name: "Исследования",
    description,
  },
  [
    ...sources.map((it) => ({ href: it.url, name: it.title, type: "CreativeWork" })),
    ...publications.map((it) => ({ href: it.url, name: it.title, type: "ScholarlyArticle" })),
  ],
);
---

<BaseLayout
  title="Исследования — Общество изучения традиционного тайцзицюань"
  description={description}
  schema={schema}
>
  <Header variant="solid" activeNav="Исследования" />
  <Breadcrumbs
    items={[{ label: "Главная", href: "/" }, { label: "Исследования" }]}
  />
  <PageTitleBand title="Исследования" />
  <ContactBar />

  {/* ── Источники ── */}
  <section id="sources" class="scroll-mt-24 bg-white py-24 max-lg:py-16">
    <div class="container-block">
      <div>
        <header data-reveal class="max-w-[760px]">
          <h2 class="text-h2-compact text-ink">Источники</h2>
          <p class="mt-4 text-body text-ink/55">
            Классические трактаты тайцзицюань в переводах.
          </p>
        </header>

        <div
          data-reveal-stagger
          class="mt-14 flex flex-col gap-8 max-lg:mt-10 max-lg:gap-6"
        >
          {sources.map((s) => <ResearchLinkCard {...s} />)}
        </div>
      </div>
    </div>
  </section>

  {/* ── Публикации ── */}
  <section
    id="publications"
    class="scroll-mt-24 border-t border-border bg-surface py-24 max-lg:py-16"
  >
    <div class="container-block">
      <div>
        <header data-reveal class="max-w-[760px]">
          <h2 class="text-h2-compact text-ink">Публикации</h2>
          <p class="mt-4 text-body text-ink/55">
            Статьи российских исследователей об истории, теории и научном изучении
            тайцзицюань.
          </p>
        </header>

        <div
          data-reveal-stagger
          class="mt-14 flex flex-col gap-8 max-lg:mt-10 max-lg:gap-6"
        >
          {publications.map((p) => <ResearchLinkCard {...p} />)}
        </div>
      </div>
    </div>
  </section>

  {/* ── Конференции ── */}
  <section
    id="conferences"
    class="scroll-mt-24 border-t border-border bg-white py-24 max-lg:py-16"
  >
    <div class="container-block">
      <div>
        <header data-reveal class="max-w-[760px]">
          <h2 class="text-h2-compact text-ink">Конференции</h2>
          <p class="mt-4 text-body text-ink/55">
            Научные и практические конференции по тайцзицюань.
          </p>
        </header>

        {/* Карточка конференции → открывает дровер-хаб (триггер [data-conference-open],
            ловит остров ConferenceDrawer). Стиль как у ResearchLinkCard, но это кнопка. */}
        <button
          type="button"
          data-conference-open
          data-reveal
          class="group mt-14 grid w-full cursor-pointer grid-cols-[1fr_auto] items-center gap-12 bg-white p-10 text-left ring-1 ring-ink/[0.08] transition-[transform,box-shadow] duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-1 hover:ring-ink/[0.14] active:translate-y-0 max-lg:mt-10 max-lg:grid-cols-1 max-lg:gap-7 max-lg:p-7"
        >
          <span class="block max-w-[760px]">
            <span class="text-eyebrow text-accent">{CONFERENCE_PLACE}</span>
            <span
              class="mt-5 block font-display text-2xl font-semibold leading-[1.2] text-ink max-lg:mt-3 max-lg:text-[20px]"
            >
              {CONFERENCE_TITLE}
            </span>
            <span
              class="mt-8 inline-flex items-center font-display text-sm font-semibold tracking-wide text-ink/40 transition-colors duration-500 group-hover:text-accent max-lg:mt-6"
            >
              Материалы конференции
            </span>
          </span>

          <span
            aria-hidden="true"
            class="grid h-16 w-16 shrink-0 place-items-center rounded-[2px] bg-accent-soft text-accent transition-all duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:-translate-y-1 group-hover:translate-x-1 group-hover:bg-accent group-hover:text-white max-lg:h-12 max-lg:w-12 max-lg:justify-self-start"
          >
            <svg
              viewBox="0 0 24 24"
              class="h-5 w-5 max-lg:h-[18px] max-lg:w-[18px]"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </span>
        </button>
      </div>
    </div>
  </section>

  {/* ── Фестивали (заглушка) ── */}
  <section
    id="festivals"
    class="scroll-mt-24 border-t border-border bg-surface py-24 max-lg:py-16"
  >
    <div class="container-block">
      <div>
        <header data-reveal class="max-w-[760px]">
          <h2 class="text-h2-compact text-ink">Фестивали</h2>
          <p class="mt-4 text-body text-ink/55">
            Фестивали и культурные программы, посвящённые тайцзицюань.
          </p>
        </header>

        <div
          data-reveal
          class="mt-14 grid min-h-[180px] place-items-center rounded-[2px] border border-dashed border-border px-6 py-16 text-center max-lg:mt-10 max-lg:min-h-[150px]"
        >
          <p class="text-body text-ink/50">Скоро здесь будет информация</p>
        </div>
      </div>
    </div>
  </section>

  {/* Дровер-хаб конференции (портал в <body>); открывается по [data-conference-open]. */}
  <ConferenceDrawer
    client:load
    title={CONFERENCE_TITLE}
    place={CONFERENCE_PLACE}
    news={conferenceNews}
    broadcastHref={conferenceBroadcastHref}
  />

  <Footer />
</BaseLayout>
