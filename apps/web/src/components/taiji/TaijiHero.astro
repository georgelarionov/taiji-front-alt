---
// Интро страницы «Тайцзицюань». Раскладка повторяет hero «Об Обществе»
// (society/SocietyHero.astro): слева — каллиграфия 太极拳, заголовок с
// подзаголовком, описание и навигация по разделам страницы; справа — тушевая
// живопись. Мобайл: та же колонка, ссылки приглушены, картина на всю ширину.
// Нижней границы у секции нет — линию рисует следующий блок (border-y у
// TaijiHistory), иначе получилась бы двойная.
import { Image } from "astro:assets";
import heroImg from "../../assets/taiji/hero.webp";
import caligraph from "../../assets/taiji/caligraph.png";

const links = [
  { label: "Истоки", href: "#istoki" },
  { label: "Теория", href: "#teoriya" },
  { label: "Персоналии", href: "#personalii" },
  { label: "Практика", href: "#praktika" },
];
---

<section class="overflow-x-clip bg-white">
  <div class="container-block">
    <div
      class="flex items-center justify-between gap-12 max-lg:flex-col max-lg:items-stretch max-lg:gap-8 max-lg:pt-8"
    >
      <div
        data-reveal
        class="flex max-w-[560px] flex-col gap-[92px] max-lg:max-w-none max-lg:gap-10"
      >
        <div class="flex flex-col gap-6 max-lg:gap-4">
          <img
            src={caligraph.src}
            width={caligraph.width}
            height={caligraph.height}
            alt=""
            aria-hidden="true"
            class="h-[38px] w-auto object-contain max-lg:h-[27px]"
          />
          <div class="flex flex-col gap-4 max-lg:gap-3">
            <h1
              class="font-serif text-[48px] font-semibold leading-[1.1] text-ink max-lg:text-[32px]"
            >
              Тайцзицюань
            </h1>
            <p
              class="font-sans text-base font-medium leading-relaxed text-ink/70 max-lg:text-[14px]"
            >
              Кулак Великого Предела
            </p>
          </div>
          <p
            class="max-w-[520px] font-sans text-[18px] leading-relaxed text-ink max-lg:text-[15px]"
          >
            Традиционное китайское искусство движения, которое возникло как боевое
            искусство, а сегодня широко практикуется как мягкая оздоровительная и
            медитативная практика.
          </p>
        </div>
        <nav class="flex flex-col gap-4" aria-label="Разделы страницы">
          {
            links.map((l) => (
              <a
                href={l.href}
                class="link-underline w-fit font-display text-base font-semibold text-ink max-lg:opacity-50"
              >
                {l.label}
              </a>
            ))
          }
        </nav>
      </div>

      <Image
        src={heroImg}
        data-reveal
        alt="Тушевая живопись: фигура в халате, выполняющая форму тайцзицюань"
        widths={[390, 720, 1440]}
        sizes="(max-width: 1023px) 100vw, 720px"
        class="h-auto w-[720px] shrink-0 object-contain max-lg:-mx-4 max-lg:w-[calc(100%+2rem)] max-lg:max-w-none"
      />
    </div>
  </div>
</section>
