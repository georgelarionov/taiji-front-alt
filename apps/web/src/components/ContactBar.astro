---
// Контактная плашка: телефон · e-mail слева + строка академической поддержки с
// чёрной эмблемой ИКСА РАН справа. Единый источник — используется в первом экране
// главной (HomeIntro) и под первым блоком внутренних страниц (/society, /news,
// /research, /events, /media-archive).
//
// topBorder — линия СВЕРХУ. Нужна только там, где над плашкой нет своего нижнего
// бордера (главная). На внутренних страницах верхняя кромка — это border-b первого
// блока (SocietyHero / PageTitleBand / интро-баннер), иначе линии стекаются в
// двойную (та же гоча, что описана в PageTitleBand).
//
// Мобайл: два ряда — телефон и e-mail колонкой, ниже строка поддержки (текст слева,
// эмблема справа, во всю ширину).
import ranEmblem from "../assets/society/iksa-ran-black.svg?url";
import { getSiteSettings } from "../lib/cms/settings";

interface Props {
  topBorder?: boolean;
}
const { topBorder = false } = Astro.props;
const settings = await getSiteSettings();
---

<div class:list={["border-b border-border bg-white", topBorder && "border-t"]}>
  <div
    class="container-block flex items-center justify-between gap-8 py-4 max-lg:flex-col max-lg:items-start max-lg:gap-4"
  >
    <div class="flex items-center gap-5 max-lg:flex-col max-lg:items-start max-lg:gap-1.5">
      <a
        href={`tel:${settings.phoneHref}`}
        class="font-display text-[17px] font-medium text-ink transition-colors hover:text-accent max-lg:text-[15px]"
      >
        {settings.phone}
      </a>
      <span class="h-6 w-px shrink-0 bg-border max-lg:hidden" aria-hidden="true"
      ></span>
      <a
        href={`mailto:${settings.email}`}
        class="font-display text-[17px] font-medium text-ink transition-colors hover:text-accent max-lg:text-[15px]"
      >
        {settings.email}
      </a>
    </div>

    <div class="flex items-center gap-4 max-lg:w-full max-lg:justify-between max-lg:gap-3">
      <p
        class="text-right font-display text-base font-semibold leading-[1.25] text-accent max-lg:text-left max-lg:text-[13px] max-lg:leading-[1.3]"
      >
        {settings.supportLine1}<br />{settings.supportLine2}
      </p>
      <img
        src={ranEmblem}
        alt="Эмблема Института Китая и современной Азии РАН"
        width="64"
        height="64"
        class="h-16 w-16 shrink-0 max-lg:h-11 max-lg:w-11"
      />
    </div>
  </div>
</div>
