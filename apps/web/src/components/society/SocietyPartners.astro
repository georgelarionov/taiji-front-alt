---
// Раздел «Партнёры» (фрейм Society). Заголовок + сетка логотипов из CMS
// (коллекция «Партнёры»). Десктоп: 4 в ряд (высота 204). Мобайл: сетка 2×2
// (высота 120). Пока партнёров не завели — показываем плейсхолдеры.
import CmsPicture from "../CmsPicture.astro";
import { getPartners } from "../../lib/cms/society";

const partners = await getPartners();
const placeholders = partners.length === 0 ? Array.from({ length: 4 }) : [];
---

<section id="partners" class="scroll-mt-24 bg-white">
  <div class="container-block flex flex-col gap-12 pb-22 max-lg:gap-8 max-lg:pb-12">
    <h2 class="text-h2 text-ink" data-reveal>Партнёры</h2>
    <div
      class="grid grid-cols-4 gap-6 max-lg:grid-cols-2 max-lg:gap-4"
      data-reveal-stagger
    >
      {
        partners.map((partner) => {
          const Box = partner.url ? "a" : "div";
          return (
            <Box
              data-reveal-item
              href={partner.url}
              target={partner.url ? "_blank" : undefined}
              rel={partner.url ? "noopener noreferrer" : undefined}
              class="flex h-[204px] items-center justify-center border border-border p-6 max-lg:h-[120px] max-lg:p-4"
            >
              {partner.logo ? (
                <CmsPicture
                  image={partner.logo}
                  alt={partner.name}
                  widths={[200, 400]}
                  sizes="200px"
                  class="max-h-full w-auto object-contain"
                />
              ) : (
                <span class="px-4 text-center font-display text-[15px] font-semibold text-ink/70">
                  {partner.name}
                </span>
              )}
            </Box>
          );
        })
      }
      {
        placeholders.map(() => (
          <div
            data-reveal-item
            class="flex h-[204px] items-center justify-center border border-border max-lg:h-[120px]"
          >
            <span class="px-4 text-center font-display text-[15px] font-semibold text-ink/35">
              Скоро здесь будет логотип
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>
