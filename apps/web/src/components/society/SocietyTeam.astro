---
// Раздел «Команда» (фрейм Society). Полоса на тоне surface-sunken. Заголовок +
// карточки персон. Десктоп: 3 ряда в сетке из 6 колонок — линия 1 (2 председателя,
// col-span-3), линия 2 (3 карточки, col-span-2), линия 3 (Петровский + CTA-карточки
// «Вступить в общество» и «Свяжитесь с нами» → /contacts, col-span-2). Мобайл:
// слайдер (React-остров). Кнопка «Подробнее» — accent-soft → accent на ховере.
// Портреты — это <Image> нельзя рендерить внутри React-острова, поэтому оптимизируем
// здесь через getImage() и передаём готовый src и в сетку, и в слайдер. Источник
// 942×1272 (ratio совпадает с боксом 111×150) → 222w webp для карточек (2×, ретина)
// и 444w для дровера (отображается крупнее). Роль/имя и биографии — единый источник
// коллекция «Команда Общества» в CMS (порядок карточек — поле «Порядок»).
import { optimizedSrc } from "../../lib/cms/image";
import SocietyTeamSlider from "./SocietyTeamSlider";
import SocietyTeamDrawer from "./SocietyTeamDrawer";
import MembershipFormDrawer from "./MembershipFormDrawer";
import { getTeam } from "../../lib/cms/society";

// E-mail Общества (тот же, что на /contacts) — закрепляется внизу формы-дровера.
const EMAIL = "info@taiji-society.ru";
const teamBios = await getTeam();

// Карточки/слайдер: id (для триггера дровера) + роль/имя + портрет 222w.
const members = await Promise.all(
  teamBios.map(async (bio) => ({
    id: bio.id,
    role: bio.role,
    name: bio.name,
    photo: bio.photo ? await optimizedSrc(bio.photo, 480) : "",
  })),
);

// Дровер: полная биография + портрет 444w.
const drawerPeople = await Promise.all(
  teamBios.map(async (bio) => ({
    ...bio,
    photo: bio.photo ? await optimizedSrc(bio.photo, 444) : "",
  })),
);
---

<section id="team" class="scroll-mt-24 bg-surface-sunken">
  <div class="container-block flex flex-col gap-12 py-18 max-lg:gap-10 max-lg:py-12">
    <h2 class="text-h2 text-ink" data-reveal>Команда</h2>

    {/* Десктоп: 3 ряда (2 / 3 / 3) в сетке из 6 колонок. Только ПК. */}
    <div class="grid grid-cols-6 gap-6 max-lg:hidden" data-reveal-stagger>
      {
        members.map((m, i) => (
          <article
            data-reveal-item
            class:list={["flex flex-col bg-white p-7", i < 2 ? "col-span-3 h-[392px]" : "col-span-2 h-[440px]"]}
          >
            <div class="flex flex-1 flex-col justify-between">
              <div class:list={["flex", i < 2 ? "items-center gap-8" : "flex-col gap-[18px]"]}>
                <img
                  src={m.photo}
                  alt=""
                  width="111"
                  height="150"
                  loading="lazy"
                  decoding="async"
                  class:list={["shrink-0 object-cover", i < 2 ? "h-[260px] w-auto" : "h-[200px] w-[150px]"]}
                />
                <div class="flex flex-col gap-3">
                  <span class="font-display text-sm font-bold uppercase tracking-[-0.14px] text-accent">
                    {m.role}
                  </span>
                  <span class="font-display text-2xl font-semibold leading-[1.3] text-ink">
                    {m.name}
                  </span>
                </div>
              </div>
              <button
                type="button"
                data-team-open={m.id}
                class="flex w-full cursor-pointer items-center justify-center bg-accent-soft py-3 font-display text-sm font-semibold text-accent transition-colors hover:bg-accent hover:text-white"
              >
                Подробнее
              </button>
            </div>
          </article>
        ))
      }

      {/* Линия 3 (после Петровского): CTA-карточки. «Вступить в общество» →
          кнопка «Отправить заявку», открывает дровер с формой заявки на вступление
          (триггер ловит остров MembershipFormDrawer). «Свяжитесь с нами» → /contacts. */}
      {
        [
          { label: "Вступить в общество", cta: "Отправить заявку", membership: true },
          { label: "Свяжитесь с нами", cta: "Контакты", href: "/contacts" },
        ].map((c) => (
          <div
            data-reveal-item
            class="col-span-2 flex flex-col items-center justify-center gap-10 border border-border text-center"
          >
            <span class="font-display text-2xl font-semibold text-ink">{c.label}</span>
            {c.membership ? (
              <button
                type="button"
                data-membership-open
                class="cursor-pointer border border-border bg-white px-8 py-4 font-display text-base font-semibold text-ink transition-colors hover:border-ink/40"
              >
                {c.cta}
              </button>
            ) : (
              <a
                href={c.href}
                class="border border-border bg-white px-8 py-4 font-display text-base font-semibold text-ink transition-colors hover:border-ink/40"
              >
                {c.cta}
              </a>
            )}
          </div>
        ))
      }
    </div>

    {/* Мобайл: слайдер персон */}
    <div class="hidden max-lg:block" data-reveal>
      <SocietyTeamSlider client:load members={members} />
    </div>

    {/* Дровер «Подробнее» (один на блок; рендерится в <body> через портал).
        Открывается по клику на [data-team-open] из сетки и из слайдера. */}
    <SocietyTeamDrawer client:load people={drawerPeople} />

    {/* Дровер с формой заявки на вступление (триггер [data-membership-open]). */}
    <MembershipFormDrawer client:load email={EMAIL} />
  </div>
</section>
