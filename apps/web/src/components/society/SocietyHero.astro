---
// Hero страницы «Об Обществе» (фрейм Society / SocietyMobile). Слева — крупный
// заголовок + список-навигация по разделам страницы; справа — тушевая живопись.
// Размерности на десктопе те же, что у первого блока /taijiquan: текстовая
// колонка 480px, заголовок 40px, ссылки 15px, а картина занимает всю
// оставшуюся ширину (`flex-1`) и держит своё соотношение через `aspect` —
// поэтому кадр не подрезается, высоту блока задаёт именно она, а текст
// центрируется в этой высоте с запасом воздуха.
// Мобайл: заголовок → ссылки (приглушённые) → картина на всю ширину.
import { Image } from "astro:assets";
import heroImg from "../../assets/society/hero.webp";

const links = [
  { label: "Миссии и ценности", href: "#mission" },
  { label: "Команда", href: "#team" },
  { label: "Партнёры", href: "#partners" },
  { label: "Документы", href: "#documents" },
];
---

<section class="overflow-x-clip border-b border-border bg-white">
  <div class="container-block">
    <div
      class="flex items-stretch justify-between gap-12 max-lg:flex-col max-lg:gap-8 max-lg:pt-8"
    >
      <div
        data-reveal
        class="flex w-[480px] shrink-0 flex-col justify-center gap-[148px] max-lg:w-auto max-lg:gap-[76px]"
      >
        <h1
          class="font-serif text-[40px] font-semibold leading-[1.1] text-ink max-lg:text-[32px]"
        >
          Исследование, сохранение и развитие традиционного тайцзицюань в России
        </h1>
        <nav class="flex flex-col gap-4" aria-label="Разделы страницы">
          {
            links.map((l) => (
              <a
                href={l.href}
                class="link-underline w-fit font-display text-[15px] font-semibold text-ink max-lg:opacity-50"
              >
                {l.label}
              </a>
            ))
          }
        </nav>
      </div>

      <div
        data-reveal
        class="relative aspect-[1440/1038] flex-1 self-center max-lg:-mx-4 max-lg:w-[calc(100%+2rem)] max-lg:flex-none"
      >
        <Image
          src={heroImg}
          alt="Тушевая живопись: фигура, практикующая тайцзицюань у воды"
          widths={[390, 720, 1080, 1440]}
          sizes="(max-width: 1023px) 100vw, 840px"
          class="absolute inset-0 h-full w-full object-cover object-center"
        />
      </div>
    </div>
  </div>
</section>
