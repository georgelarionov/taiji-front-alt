---
// Текст абзаца/пункта/подписи/цитаты с оформлением из CMS: **жирный**, *курсив*,
// ~~зачёркнутый~~, [подпись](адрес), голые https-адреса, переносы строк (см.
// lib/inline-markup). set:html здесь безопасен: markdown-it работает с html:false —
// любой HTML, вписанный в текст, экранируется.
import { renderInline } from "../../lib/inline-markup";

interface Props {
  text: string;
}
const { text } = Astro.props;
---

<Fragment set:html={renderInline(text)} />
