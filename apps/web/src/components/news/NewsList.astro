---
// Лента новостей /news. По умолчанию (ПК) — сетка «3 в ряд» на всю ширину контейнера;
// альтернатива — одна колонка max-w-[809px] по центру (между карточками <hr>).
//
// Переключатель вида (ТОЛЬКО ПК, .news-bar с max-lg:hidden): «1 колонка / 3 в ряд».
// Zero-JS — два radio-инпута + :has() в global.css переключают .news-items между
// колонкой и сеткой 3×N (мобайл всегда одна колонка). Иконки — currentColor.
// Дефолт — сетка 3 в ряд (см. global.css: раскладка на :not(:has(list:checked))).
//
// Все карточки страницы показываются сразу (по 6 из paginate()); отдельной кнопки
// «Показать ещё» нет — навигация по ленте только цифрами пагинации.
//
// Постраничная пагинация (опц. проп `page` из Astro paginate()) рендерится снизу через
// <Pagination>: номера листают между реальными URL /news · /news/2 · …
// (см. pages/news/[...page]).
import NewsCard from "./NewsCard.astro";
import Pagination from "./Pagination.astro";
import type { CmsImage } from "../../lib/cms/client";

interface Item {
  date: string;
  title: string;
  excerpt: string;
  image?: CmsImage;
  imageAlt?: string;
  href: string;
}
interface Props {
  items: Item[];
  // Метаданные страницы из paginate() — для нижней навигации по страницам.
  page?: {
    currentPage: number;
    lastPage: number;
    url: { prev?: string; next?: string };
  };
}
const { items, page } = Astro.props;
const rule = "my-8 border-0 border-t border-border max-lg:my-10";

const toggleLabel =
  "grid h-9 w-9 cursor-pointer place-items-center rounded-[2px] text-ink/45 transition-colors hover:text-ink";
---

<section class="bg-white pt-12 pb-[140px] max-lg:py-10">
  <div class="container-block">
    <div class="news-feed">
      {/* Тулбар «Вид: [3 в ряд] [1 колонка]» — только ПК. Radio + :has() (zero-JS).
          Дефолт-primary «3 в ряд» идёт первым и отмечен (checked); раскладка в
          global.css висит на :not(:has(#news-view-list:checked)) → сетка по умолчанию. */}
      <div class="news-bar mx-auto mb-8 w-full max-w-[809px] max-lg:hidden">
        <div class="flex items-center justify-end gap-3">
          <span class="font-display text-sm font-semibold text-ink/60">Вид:</span>
          <fieldset class="inline-flex items-center gap-1 border border-border p-1">
            <legend class="sr-only">Вид ленты новостей</legend>

            <input
              type="radio"
              name="news-view"
              id="news-view-grid"
              class="peer/grid sr-only"
              checked
            />
            <label
              for="news-view-grid"
              title="3 в ряд"
              class:list={[
                toggleLabel,
                "peer-checked/grid:bg-accent peer-checked/grid:text-white peer-focus-visible/grid:ring-2 peer-focus-visible/grid:ring-accent/40",
              ]}
            >
              <span class="sr-only">3 в ряд</span>
              <svg viewBox="0 0 20 20" fill="currentColor" class="h-[18px] w-[18px]" aria-hidden="true">
                <rect x="2" y="3" width="4" height="14" rx="1"></rect>
                <rect x="8" y="3" width="4" height="14" rx="1"></rect>
                <rect x="14" y="3" width="4" height="14" rx="1"></rect>
              </svg>
            </label>

            <input
              type="radio"
              name="news-view"
              id="news-view-list"
              class="peer/list sr-only"
            />
            <label
              for="news-view-list"
              title="1 в ряд"
              class:list={[
                toggleLabel,
                "peer-checked/list:bg-accent peer-checked/list:text-white peer-focus-visible/list:ring-2 peer-focus-visible/list:ring-accent/40",
              ]}
            >
              <span class="sr-only">1 в ряд</span>
              <svg viewBox="0 0 20 20" fill="currentColor" class="h-[18px] w-[18px]" aria-hidden="true">
                <rect x="3" y="4" width="14" height="3" rx="1"></rect>
                <rect x="3" y="13" width="14" height="3" rx="1"></rect>
              </svg>
            </label>
          </fieldset>
        </div>
      </div>

      <div class="news-items mx-auto w-full max-w-[809px]">
        {
          items.map((item, i) => (
            <Fragment>
              {i > 0 && <hr class={rule} />}
              <NewsCard {...item} />
            </Fragment>
          ))
        }
      </div>

      {page && <Pagination page={page} />}
    </div>
  </div>
</section>
