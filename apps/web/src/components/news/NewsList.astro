---
// Лента новостей /news. По умолчанию — одна колонка max-w-[809px] по центру; между
// карточками <hr>-разделитель border-border (по дизайну — линия по центру 64px-зазора).
//
// Переключатель вида (ТОЛЬКО ПК, .news-bar с max-lg:hidden): «1 колонка / 2 колонки».
// Zero-JS — два radio-инпута + :has() в global.css переключают .news-items/.news-rest
// между колонкой и сеткой 2×N (мобайл всегда одна колонка). Иконки — currentColor.
//
// «Показать ещё» — zero-JS через <details>/<summary> (не ломается под <ClientRouter />,
// доступно с клавиатуры): первые `initial` карточек статичны, кнопка + остальные лежат
// в <details> (rest обёрнут в .news-rest — чтобы в режиме сетки лечь в свою 2-колоночную
// решётку). <summary> стилизован как ghost-кнопка и прячется при раскрытии
// (details[open] > summary{display:none}).
import NewsCard from "./NewsCard.astro";
import type { ImageMetadata } from "astro";

interface Item {
  date: string;
  title: string;
  excerpt: string;
  image?: ImageMetadata;
  imageAlt?: string;
  href: string;
}
interface Props {
  items: Item[];
  initial?: number;
}
const { items, initial = 6 } = Astro.props;
const visible = items.slice(0, initial);
const rest = items.slice(initial);
const rule = "my-8 border-0 border-t border-border max-lg:my-10";

const toggleLabel =
  "grid h-9 w-9 cursor-pointer place-items-center rounded-[2px] text-ink/45 transition-colors hover:text-ink";
---

<section class="bg-white pt-12 pb-[140px] max-lg:py-10">
  <div class="container-block">
    <div class="news-feed">
      {/* Тулбар «Вид: [1 колонка] [сетка]» — только ПК. Radio + :has() (zero-JS). */}
      <div class="news-bar mx-auto mb-8 w-full max-w-[809px] max-lg:hidden">
        <div class="flex items-center justify-end gap-3">
          <span class="font-display text-sm font-semibold text-ink/60">Вид:</span>
          <fieldset class="inline-flex items-center gap-1 border border-border p-1">
            <legend class="sr-only">Вид ленты новостей</legend>

            <input
              type="radio"
              name="news-view"
              id="news-view-list"
              class="peer/list sr-only"
              checked
            />
            <label
              for="news-view-list"
              title="В одну колонку"
              class:list={[
                toggleLabel,
                "peer-checked/list:bg-accent peer-checked/list:text-white peer-focus-visible/list:ring-2 peer-focus-visible/list:ring-accent/40",
              ]}
            >
              <span class="sr-only">В одну колонку</span>
              <svg viewBox="0 0 20 20" fill="currentColor" class="h-[18px] w-[18px]" aria-hidden="true">
                <rect x="3" y="4" width="14" height="3" rx="1"></rect>
                <rect x="3" y="13" width="14" height="3" rx="1"></rect>
              </svg>
            </label>

            <input
              type="radio"
              name="news-view"
              id="news-view-grid"
              class="peer/grid sr-only"
            />
            <label
              for="news-view-grid"
              title="В два столбца"
              class:list={[
                toggleLabel,
                "peer-checked/grid:bg-accent peer-checked/grid:text-white peer-focus-visible/grid:ring-2 peer-focus-visible/grid:ring-accent/40",
              ]}
            >
              <span class="sr-only">В два столбца</span>
              <svg viewBox="0 0 20 20" fill="currentColor" class="h-[18px] w-[18px]" aria-hidden="true">
                <rect x="3" y="3" width="6" height="14" rx="1"></rect>
                <rect x="11" y="3" width="6" height="14" rx="1"></rect>
              </svg>
            </label>
          </fieldset>
        </div>
      </div>

      <div class="news-items mx-auto w-full max-w-[809px]">
        {
          visible.map((item, i) => (
            <Fragment>
              {i > 0 && <hr class={rule} />}
              <NewsCard {...item} />
            </Fragment>
          ))
        }

        {
          rest.length > 0 && (
            <details class="news-more">
              <summary class="news-more-btn mx-auto mt-12 flex w-fit cursor-pointer list-none items-center justify-center border border-accent px-8 py-4 font-display text-base font-semibold text-accent transition-colors hover:bg-accent hover:text-white max-lg:mt-10">
                Показать ещё
              </summary>
              <div class="news-rest">
                {rest.map((item) => (
                  <Fragment>
                    <hr class={rule} />
                    <NewsCard {...item} />
                  </Fragment>
                ))}
              </div>
            </details>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* Прячем кнопку, когда лента раскрыта; убираем дефолтный маркер <details>. */
  details[open] > summary {
    display: none;
  }
  .news-more-btn::-webkit-details-marker {
    display: none;
  }
</style>
